{
  "name": "dance-studio",
  "private": true,
  "version": "1.0.0",
  "description": "マネキンが踊る無音動画を作る、映像変換サービス向けの素材づくりアプリ",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
