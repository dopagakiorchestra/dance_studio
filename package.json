    "typecheck": "tsc --noEmit",
    "pose:assets": "node scripts/fetch-pose-assets.mjs",
    "prebuild": "node scripts/fetch-pose-assets.mjs",
    "predev": "node scripts/fetch-pose-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopagakiorchestra/dance_studio.git"
  },
  "homepage": "https://dopagakiorchestra.github.io/dance_studio/",
  "license": "ISC",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
